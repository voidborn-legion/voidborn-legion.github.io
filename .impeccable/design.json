  "narrative": {
    "northStar": "Nächtlicher Legionsatlas",
    "overview": "Ein nächtlicher Legionsatlas: atmosphärisch im Einstieg, präzise in der Orientierung und ruhig beim Lesen. Dunkle blaue Flächen, elfenbeinfarbene Schrift und sparsam eingesetztes Gold verbinden die Academy mit Voidborn. Die originale Fantasy-Zitadelle trägt die Stimmung; sie ist kein Beleg für Spielmechaniken.\n\nDie Website ist eine technische Vorschau vor der Discord-Migration. Hinweisflächen und Guide-Platzhalter kennzeichnen diesen Stand sichtbar. Das System übernimmt VitePress-Leseführung und lokale Suche, während die Startseite zwei Einstiegswege, filterbare Themen und zurückhaltende Routineverweise anbietet.",
    "keyCharacteristics": [
      "Nächtliche Flächen mit klarer Lesbarkeit",
      "Cinzel als Akzent, Source Sans 3 als Arbeitsstimme",
      "Gold für Orientierung und ausgewählte Aktionen",
      "Tonal geschichtete Karten ohne schwebende Effekte"
    ],
    "rules": [
      {
        "name": "Gold as Wayfinding",
        "body": "Gold priorisiert Aktionen und Orientierung; lange Lesetexte bleiben elfenbeinfarben.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do die originale Zitadelle als Atmosphäre verwenden und Text durch dunkle Verläufe lesbar halten.",
      "Do sichtbaren Tastaturfokus und mindestens 44px hohe Filterziele erhalten.",
      "Do Vorschau- und Migrationsstatus klar sichtbar halten.",
      "Do die reduzierte Bewegung respektieren."
    ],
    "donts": [
      "Don’t Spielmechaniken durch atmosphärische Bilder belegen.",
      "Don’t offizielle Spieloberflächen, Siegel oder unbelegte Fortschrittswerte imitieren.",
      "Don’t Cinzel für lange Fließtexte einsetzen."
    ]
  }
